# $NetBSD: Makefile.common,v 1.18 2026/04/12 18:29:17 wiz Exp $
# used by graphics/giflib/Makefile
# used by graphics/giflib-util/Makefile

DISTNAME=	giflib-6.1.3
CATEGORIES=	graphics
MASTER_SITES=	${MASTER_SITE_SOURCEFORGE:=giflib/}

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://giflib.sourceforge.net/
LICENSE=	mit

PATCHDIR=	${.CURDIR}/../../graphics/giflib/patches
DISTINFO_FILE=	${.CURDIR}/../../graphics/giflib/distinfo

USE_LANGUAGES=		c c++
USE_LIBTOOL=		yes
USE_TOOLS+=		gmake

.include "../../mk/bsd.prefs.mk"

.if ${OPSYS} == "NetBSD" && ${OPSYS_VERSION} >= 100000
CFLAGS.NetBSD+=	-DHAVE_REALLOCARRAY
.endif
